<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Photographer Portfolio</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Freight+Display+Pro&display=swap" rel="stylesheet">
  <style>
    /* General Styles */
    body {
      font-family: 'Freight Display Pro', serif;
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
    }

    /* Navbar Styles */
    .navbar {
      background-color: #333;
      color: #fff;
      padding: 10px 0;
    }

    .navbar .nav-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 20px;
    }

    .navbar .nav-name {
      font-size: 1.5rem;
      font-weight: bold;
    }

    .navbar .hamburger-icon {
      font-size: 2rem;
      cursor: pointer;
    }

    /* Dropdown Styles */
    .dropdown {
      margin: 20px auto;
      text-align: center;
    }

    .dropdown select {
      font-family: 'Freight Display Pro', serif;
      padding: 10px;
      font-size: 1rem;
      border: 2px solid #ccc;
      border-radius: 5px;
      background-color: #fff;
      cursor: pointer;
      width: 200px;
    }

    .dropdown select:hover {
      border-color: #333;
    }

    /* Gallery Styles */
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
      padding: 20px;
      margin: 0 10%;
    }

    .gallery .photo-container {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
    }

    .gallery .photo-container img {
      width: 100%;
      height: auto;
      display: block;
      transition: transform 0.3s ease-in-out;
    }

    .gallery .photo-container img:hover {
      transform: scale(1.05);
      cursor: pointer;
    }

    /* Popup Styles */
    .popup-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: none;
      justify-content: center;
      align-items: center;
      background: rgba(0, 0, 0, 0.8);
      z-index: 1000;
    }

    .popup-modal img {
      max-width: 90%;
      max-height: 90%;
      object-fit: contain;
    }

    .popup-modal .close-icon {
      position: absolute;
      top: 20px;
      right: 20px;
      font-size: 2rem;
      color: white;
      cursor: pointer;
    }

  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="nav-content">
      <div class="nav-name">Corinne Hatch Photography</div>
      <div class="nav-menu">
        <span class="hamburger-icon" onclick="openPopup()">&#9776;</span>
      </div>
    </div>
  </nav>

  <!-- Dropdown for Photo Categories -->
  <div class="dropdown">
    <label for="photo-category">Select Photo Category:</label>
    <select id="photo-category">
      <option value="portrait">Portrait</option>
      <option value="landscape">Landscape</option>
      <option value="nature">Nature</option>
      <option value="architectural">Architectural</option>
    </select>
  </div>

  <!-- Gallery Section -->
  <section class="gallery">
    <div class="photo-container" data-category="portrait">
      <img src="/blur.jpeg" alt="Blur Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/blur.jpeg')">
    </div>
    <div class="photo-container" data-category="landscape">
      <img src="/closeelephant.jpeg" alt="Close Elephant Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/closeelephant.jpeg')">
    </div>
    <div class="photo-container" data-category="nature">
      <img src="/dock.jpeg" alt="Dock Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/dock.jpeg')">
    </div>
    <div class="photo-container" data-category="portrait">
      <img src="/elephant.jpeg" alt="Elephant Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/elephant.jpeg')">
    </div>
    <div class="photo-container" data-category="portrait">
      <img src="/eye.jpeg" alt="Eye Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/eye.jpeg')">
    </div>
    <div class="photo-container" data-category="nature">
      <img src="/flytrap.jpeg" alt="Flytrap Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/flytrap.jpeg')">
    </div>
    <div class="photo-container" data-category="portrait">
      <img src="/girlflower.jpeg" alt="Girl Flower Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/girlflower.jpeg')">
    </div>
    <div class="photo-container" data-category="portrait">
      <img src="/girlsmile.jpeg" alt="Girl Smile Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/girlsmile.jpeg')">
    </div>
    <div class="photo-container" data-category="architectural">
      <img src="/lamp.jpeg" alt="Lamp Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/lamp.jpeg')">
    </div>
    <div class="photo-container" data-category="portrait">
      <img src="/laugh.jpeg" alt="Laugh Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/laugh.jpeg')">
    </div>
    <div class="photo-container" data-category="portrait">
      <img src="/littleboy.jpeg" alt="Little Boy Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/littleboy.jpeg')">
    </div>
    <div class="photo-container" data-category="nature">
      <img src="/monkey.jpeg" alt="Monkey Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/monkey.jpeg')">
    </div>
    <div class="photo-container" data-category="nature">
      <img src="/mountain.jpeg" alt="Mountain Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/mountain.jpeg')">
    </div>
    <div class="photo-container" data-category="nature">
      <img src="/purpflower.jpeg" alt="Purple Flower Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/purpflower.jpeg')">
    </div>
    <div class="photo-container" data-category="landscape">
      <img src="/reflection.jpeg" alt="Reflection Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/reflection.jpeg')">
    </div>
    <div class="photo-container" data-category="nature">
      <img src="/sky.jpeg" alt="Sky Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/sky.jpeg')">
    </div>
    <div class="photo-container" data-category="portrait">
      <img src="/smile.jpeg" alt="Smile Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/smile.jpeg')">
    </div>
    <div class="photo-container" data-category="nature">
      <img src="/snail.jpeg" alt="Snail Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/snail.jpeg')">
    </div>
    <div class="photo-container" data-category="architectural">
      <img src="/temple.jpeg" alt="Temple Image" onclick="openPhoto('/Users/spencerbullock/Downloads/403Project-main/Public/temple.jpeg')">
    </div>
  </section>

  <!-- Popup Modal for Image -->
  <div class="popup-modal" id="popupModal">
    <span class="close-icon" onclick="closePopup()">&#10005;</span>
    <img id="popupImage" src="" alt="Expanded Image">
  </div>

  <script>
    // Open Photo Popup
    function openPhoto(imagePath) {
      const popupModal = document.getElementById('popupModal');
      const popupImage = document.getElementById('popupImage');
      popupModal.style.display = 'flex';
      popupImage.src = imagePath;
    }

    // Close Photo Popup
    function closePopup() {
      document.getElementById('popupModal').style.display = 'none';
    }

    // Filter Gallery Based on Category
    document.getElementById("photo-category").addEventListener("change", function() {
      const selectedCategory = this.value;
      const photos = document.querySelectorAll('.photo-container');
      photos.forEach(photo => {
        if (photo.getAttribute('data-category') === selectedCategory || selectedCategory === "") {
          photo.style.display = "block";
        } else {
          photo.style.display = "none";
        }
      });
    });
  </script>

</body>
</html

