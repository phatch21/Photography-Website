<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/styles.css"> <!-- Link to the external styles.css -->
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="nav-content">
        <div class="nav-name">Corinne Hatch Photography</div>
        <div class="nav-menu">
            <span class="hamburger-icon" onclick="openPopup()">&#9776;</span>
        </div>
        </div>
    </nav>

    <!-- Popup Modal -->
    <div class="popup-modal" id="popupModal">
        <div class="modal-content">
        <span class="close-icon" onclick="closePopup()">&#10005;</span>
        <a href="/" onclick="closePopup()">Home</a>
        <a href="/gallery" onclick="closePopup()">Gallery</a>
        <a href="/admin" onclick="closePopup()">Admin</a>
        </div>
    </div>

    <br><br><br><br>

    <div class="form-container">
    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>Password</th>
                <th>Modify</th>
            </tr>
        </thead>
        <tbody>
            <% if (admin.length > 0) { %>
                <% admin.forEach(row => { %>
                <tr>
                    <input type="hidden" value="<%= row.username %>">
                    <td><%= row.username%></td>
                    <td><%= row.password %></td>
                    <td>
                        <form action="/editAdmin/<%= row.username %>" method="GET" style="display:inline;">
                            <button type="submit">Edit</button>
                        </form>
                        <form action="/deleteAdmin/<%= row.username %>" method="POST" style="display:inline;">
                            <button type="submit" onclick="return confirm('Are you sure you want to delete this record?');">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4">No data available</td>
                </tr>
            <% } %>
        </tbody>
    </table>
    
    <br>

    <form action="/addAdmin" method="GET" style="text-align: center;">
        <button type="submit">Add Admin</button>
    </form>
    </div>
    <br>

    <script>
        // Popup functions
        function openPopup() {
          document.getElementById("popupModal").style.display = "flex";
        }
        function closePopup() {
          document.getElementById("popupModal").style.display = "none";
        }
    </script>

</body>
</html>
