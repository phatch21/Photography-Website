<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Photographer Portfolio</title>
  <link rel="stylesheet" href="styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Freight+Display+Pro&display=swap" rel="stylesheet">
  <style>
    /* General Styles */
    body {
      font-family: 'Freight Display Pro', serif;
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
    }

    /* Navbar Styles */
    .navbar {
      background-color: #333;
      color: #fff;
      padding: 10px 0;
    }

    .navbar .nav-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 20px;
    }

    .navbar .nav-name {
      font-size: 1.5rem;
      font-weight: bold;
    }

    .navbar .hamburger-icon {
      font-size: 2rem;
      cursor: pointer;
    }

    /* Dropdown Styles */
    .dropdown {
      margin: 20px auto;
      text-align: center;
    }

    .dropdown select {
      font-family: 'Freight Display Pro', serif;
      padding: 10px;
      font-size: 1rem;
      border: 2px solid #ccc;
      border-radius: 5px;
      background-color: #fff;
      cursor: pointer;
      width: 200px;
    }

    .dropdown select:hover {
      border-color: #333;
    }

    /* Gallery Styles */
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
      padding: 20px;
      margin: 0 10%;
    }

    .gallery .photo-container {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
    }

    .gallery .photo-container img {
      width: 100%;
      height: auto;
      display: block;
      transition: transform 0.3s ease-in-out;
    }

    .gallery .photo-container img:hover {
      transform: scale(1.05);
      cursor: pointer;
    }

    /* Popup Styles */
    .popup-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: none;
      justify-content: center;
      align-items: center;
      background: rgba(0, 0, 0, 0.8);
      z-index: 1000;
    }

    .popup-modal img {
      max-width: 90%;
      max-height: 90%;
      object-fit: contain;
    }

    .popup-modal .close-icon {
      position: absolute;
      top: 20px;
      right: 20px;
      font-size: 2rem;
      color: white;
      cursor: pointer;
    }

    .gallery-title {
      text-align: center;
      font-size: 2rem;
      margin: 40px 0 10px;
      font-weight: bold;
    }

  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="nav-content">
      <div class="nav-name">Corinne Hatch Photography</div>
      <div class="nav-menu">
        <span class="hamburger-icon" onclick="openPopup()">&#9776;</span>
      </div>
    </div>
  </nav>

  <!-- Popup Modal -->
  <div class="popup-modal" id="popupModal">
    <div class="modal-content">
      <span style='color: black;' class="close-icon" onclick="closePopup()">&times;</span>
      <a href="/" onclick="closePopup()">Home</a>
      <a href="/gallery" onclick="closePopup()">Gallery</a>
      <a href="#contact" onclick="closePopup()">Contact</a>
      <a href="/admin" onclick="closePopup()">Admin</a>
    </div>
  </div>

  <div class="gallery-title"><br>Photo Gallery</div>
  <hr>
  
  <!-- Dropdown for Photo Categories -->
    <div class="dropdown">
        <label for="photo-category">Select Category:</label>
        <select id="photo-category">
            <option value="all">All Categories</option>
        <% categories.forEach(category => { %>
            <option value="<%= category.categoryID %>"><%= category.catName %></option>
        <% }) %>
        </select>
    </div>

  <!-- Dropdown for Albums -->
    <div class="dropdown">
        <label for="photo-album">Select Album:</label>
        <select id="photo-album">
            <option value="all">All Albums</option>
        <% albums.forEach(album => { %>
            <option value="<%= album.albumID %>"><%= album.albumName %></option>
        <% }) %>
        </select>
    </div>

  <!-- Gallery Section -->
<!-- Updated EJS Template -->
    <section class="gallery">
        <% if (photos.length > 0) { %>
        <% photos.forEach(photo => { %>
            <div class="photo-container" data-category="<%= photo.categoryID %>" data-album="<%= photo.albumID %>">
            <img src="<%= photo.filePath %>" alt="<%= photo.fileDescription || 'Image' %>" 
                onclick="openPhoto('<%= photo.filePath %>')">
            </div>
        <% }) %>
        <% } else { %>
        <p>No photos found.</p>
        <% } %>
    </section>

  <!-- Popup Modal for Image -->
  <div class="popup-modal" id="popupModal">
    <span class="close-icon" onclick="closePopup()">&#10005;</span>
    <img id="popupImage" src="" alt="Expanded Image">
  </div>

  <script>
    // Popup functions
    function openPopup() {
      document.getElementById("popupModal").style.display = "flex";
    }
    function closePopup() {
      document.getElementById("popupModal").style.display = "none";
    }

    // Open Photo Popup
    function openPhoto(imagePath) {
    const popupModal = document.getElementById("popupModal");
    const popupImage = document.getElementById("popupImage");
    popupModal.style.display = "flex";
    popupImage.src = imagePath;
    }

    // Filter Gallery Based on Album and Category
    function applyFilter() {
        const selectedCategory = document.getElementById("photo-category").value;
        const selectedAlbum = document.getElementById("photo-album").value;

        const photos = document.querySelectorAll(".photo-container");

        photos.forEach((photo) => {
            const photoCategory = photo.getAttribute("data-category");
            const photoAlbum = photo.getAttribute("data-album");

            // Check if filters match or if "all" is selected
            const matchesCategory = selectedCategory === "all" || selectedCategory === photoCategory;
            const matchesAlbum = selectedAlbum === "all" || selectedAlbum === photoAlbum;

            if (matchesCategory && matchesAlbum) {
            photo.style.display = "block";
            } else {
            photo.style.display = "none";
            }
        });
    }

    // Event listeners for dropdowns
    document.getElementById("photo-category").addEventListener("change", applyFilter);
    document.getElementById("photo-album").addEventListener("change", applyFilter);

    // Apply filter on page load
    window.onload = applyFilter;
    </script>

</body>
</html>
