<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Admin</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
      <div class="nav-content">
        <div class="nav-name">Corinne Hatch Photography</div>
        <div class="nav-menu">
          <span class="hamburger-icon" onclick="openPopup()">&#9776;</span>
        </div>
      </div>
    </nav>
    <h1 style="text-align: center;">Edit Admin</h1>

    <form class="form-container" action="/editAdmin/<%= admin.username %>" method="POST">
        <!-- Username Field -->
        <label for="username">New Username</label>
        <input type="text" id="username" name="username" value="<%= admin.username %>" required>

        <!-- Password Field -->
        <label for="password">New Password</label>
        <input type="password" id="password" name="password" required>

        <!-- Submit Button -->
        <button type="submit">Save Changes</button>
    </form>
</body>
</html>
