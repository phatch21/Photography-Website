<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Admin</title>
    <link rel="stylesheet" href="styles.css">
</head>
<main>
    <body>

        <!-- Navbar -->
        <nav class="navbar">
            <div class="nav-content">
            <div class="nav-name">Corinne Hatch Photography</div>
            <div class="nav-menu">
                <span class="hamburger-icon" onclick="openPopup()">&#9776;</span>
            </div>
            </div>
        </nav>

        <!-- Popup Modal -->
        <div class="popup-modal" id="popupModal">
            <div class="modal-content">
            <span class="close-icon" onclick="closePopup()">&#10005;</span>
            <a href="/" onclick="closePopup()">Home</a>
            <a href="/gallery" onclick="closePopup()">Gallery</a>
            <a href="#contact" onclick="closePopup()">Contact</a>
            <a href="/admin" onclick="closePopup()">Admin</a>
            </div>
        </div>

        <h1 style="text-align: center;">Create New Admin</h1>
        <form action="/addAdmin" method="POST" class="form-container">
            <label for="username" >Enter your username:</label>
            <input type="text" id="username" name="username" >
            <br><br>
            <label for="password" >Enter your password:</label>
            <input type="password" id="password" name="password">
            <br><br>
            <button type="submit">Create User</button>
        </form>

        <script>
            // Popup functions
            function openPopup() {
              document.getElementById("popupModal").style.display = "flex";
            }
            function closePopup() {
              document.getElementById("popupModal").style.display = "none";
            }
        </script>

    </body>
</main>

</html>