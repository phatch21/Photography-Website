<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/styles.css"> <!-- Link to the external styles.css -->
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="nav-content">
        <div class="nav-name">Corinne Hatch Photography</div>
        <div class="nav-menu">
            <span class="hamburger-icon" onclick="openPopup()">&#9776;</span>
        </div>
        </div>
    </nav>

    <br><br><br><br>

    <div class="form-container">
    <table>
        <thead>
            <tr>
                <th>Photo</th>
                <th>Photo Name</th>
                <th>Album</th>
                <th>Category</th>
                <th>Description</th>
                <th>Modify</th>
            </tr>
        </thead>
        <tbody>
            <% if (photo.length > 0) { %>
                <% photo.forEach(row => { %>
                <tr>
                    <input type="hidden" value="<%= row.photoID %>">
                    <td>
                        <div class="photo-container" data-category="<%= photo.categoryID %>" data-album="<%= photo.albumID %>">
                            <img src="<%= photo.filePath %>" alt="<%= photo.fileDescription || 'Image' %>" >
                        </div>
                    </td>
                    <td><%= row.photoName%></td>
                    <td><%= row.albumID %></td>
                    <td><%= row.categoryID%></td>
                    <td><%= row.description%></td>
                    <td>
                        <form action="/editImage/<%= row.photoID %>" method="GET" style="display:inline;">
                            <button type="submit">Edit</button>
                        </form>
                        <form action="/deleteImage/<%= row.photoID %>" method="POST" style="display:inline;">
                            <button type="submit" onclick="return confirm('Are you sure you want to delete this record?');">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4">No data available</td>
                </tr>
            <% } %>
        </tbody>
    </table>
     
    <form action="/upload" method="GET" style="text-align: center;">
        <button type="submit">Add New Image</button>
    </form>
    </div>
    <br>
</body>
</html>
